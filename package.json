{
  "name": "stock-management",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @stock/db migrate:deploy",
    "db:seed": "pnpm --filter @stock/db seed"
  },
  "devDependencies": {
    "turbo": "^1.13.3",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
